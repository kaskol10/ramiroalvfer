---
import { getEntry } from 'astro:content';
import { projects } from '../data/projects';
import { gpuGuide } from '../data/gpu-guide';

const post = await getEntry('posts', 'gpu-hami-k8s');
const tool = projects.find((p) => p.slug === 'karpenter-optimizer');

const items = [
  {
    kind: 'field guide',
    title: gpuGuide.title,
    description: gpuGuide.description,
    href: '/gpu-on-kubernetes',
    external: false,
  },
  ...(post
    ? [
        {
          kind: 'post',
          title: post.data.title,
          description: post.data.description,
          href: `/blog/${post.id}`,
          external: false,
        },
      ]
    : []),
  ...(tool
    ? [
        {
          kind: 'open source',
          title: tool.name,
          description: tool.description,
          href: tool.url,
          external: true,
        },
      ]
    : []),
];
---

<section id="start-here" class="scroll-mt-20 border-b border-line py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <p class="label mb-3">[ start here ]</p>
    <h2 class="font-display text-3xl font-bold tracking-tight text-bone sm:text-4xl">
      Three things to read first
    </h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {items.map((item, index) => (
        <li class="reveal" style={`transition-delay: ${index * 80}ms`}>
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="frame group flex h-full flex-col border border-line bg-surface-raised p-6 hover:border-accent"
          >
            <p class="label text-accent">{item.kind}</p>
            <h3 class="mt-2 font-display text-xl font-semibold leading-snug text-bone group-hover:text-accent">
              {item.title}
            </h3>
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ash">{item.description}</p>
            <p class="mt-auto pt-6 font-mono text-[11px] uppercase tracking-[0.12em] text-bone-dim group-hover:text-accent">
              {item.external ? 'open ↗' : 'read ▸'}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
