---
import type { Talk } from '../data/talks';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/utils';

type Props = {
  talks: Talk[];
  posts: CollectionEntry<'posts'>[];
};

const { talks, posts } = Astro.props;
---

<section class="border-b border-line py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-[1.15fr_0.85fr] md:px-6">
    {/* Writing second to projects, ahead of speaking — field notes back the OSS work */}
    <div class="reveal">
      <p class="label mb-3">[ field notes · backs the work ]</p>
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="font-display text-3xl font-bold text-bone">Writing</h2>
        <a href="/blog" class="font-mono text-[11px] uppercase tracking-[0.12em] text-accent hover:underline">
          All posts ▸▸▸
        </a>
      </div>
      <ul class="divide-y divide-line border border-line">
        {posts.slice(0, 5).map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="block px-4 py-4 hover:bg-surface-raised">
              <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-ash">
                {formatDate(post.data.date)}
                {post.data.categories?.[0] && <> · {post.data.categories[0]}</>}
              </p>
              <p class="mt-1 font-display text-base font-semibold text-bone">{post.data.title}</p>
              <p class="mt-1 line-clamp-2 text-sm text-ash">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal" style="transition-delay: 100ms">
      <p class="label mb-3">[ session log · archive ]</p>
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="font-display text-3xl font-bold text-bone">Speaking</h2>
        <a href="/speaking" class="font-mono text-[11px] uppercase tracking-[0.12em] text-accent hover:underline">
          All talks ▸▸▸
        </a>
      </div>
      <ul class="divide-y divide-line border border-line">
        {talks.slice(0, 4).map((talk) => (
          <li>
            <a
              href={talk.url ?? '/speaking'}
              class="block px-4 py-4 hover:bg-surface-raised"
              target={talk.url?.startsWith('http') ? '_blank' : undefined}
              rel={talk.url?.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-ash">
                {talk.session} · {talk.event} · {talk.date}
              </p>
              <p class="mt-1 font-display text-base font-semibold text-bone">{talk.title}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
