---
import { Image } from 'astro:assets';
import portrait from '../assets/images/portrait.jpeg';
import { site, socials } from '../data/socials';
import { productProjects } from '../data/projects';
import { certifications } from '../data/certifications';
import { talks } from '../data/talks';
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(45,212,191,0.12),transparent_55%)]"></div>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-[1.2fr_0.8fr] md:items-end md:px-6 md:py-24 lg:py-28">
    <div class="relative z-10">
      <p class="label mb-5 text-accent">
        {site.name} · Staff Platform Engineer · Golden Kubestronaut
      </p>
      <h1 class="font-display text-4xl font-bold leading-[1.02] tracking-tight text-bone sm:text-5xl lg:text-6xl">
        I run AI and GPU workloads on Kubernetes,
        <span class="text-accent">and make them cheaper.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-ash sm:text-lg">
        I lead platform engineering at Empathy.co: Kubernetes platforms, self-hosted AI and inference
        workloads. I build karpenter-optimizer and CanISpot.ai, and write up what GPU sharing and cloud
        cost look like in production.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#start-here"
          class="border border-accent bg-accent/10 px-5 py-2.5 font-mono text-xs uppercase tracking-[0.14em] text-accent hover:bg-accent hover:text-ink"
        >
          Start here ▾
        </a>
        <a
          href={socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-line px-5 py-2.5 font-mono text-xs uppercase tracking-[0.14em] text-bone-dim hover:border-accent hover:text-accent"
        >
          GitHub ↗
        </a>
      </div>
      <dl class="mt-12 grid grid-cols-2 gap-px border border-line bg-line sm:grid-cols-4">
        <div class="bg-surface-raised p-4">
          <dt class="label">Golden Kubestronaut</dt>
          <dd class="mt-2 font-display text-lg font-semibold leading-tight text-bone">First in Spain</dd>
        </div>
        <div class="bg-surface-raised p-4">
          <dt class="label">Certifications</dt>
          <dd class="mt-2 font-display text-2xl font-semibold text-bone">{certifications.length}</dd>
        </div>
        <div class="bg-surface-raised p-4">
          <dt class="label">Talks given</dt>
          <dd class="mt-2 font-display text-2xl font-semibold text-bone">{talks.length}</dd>
        </div>
        <div class="bg-surface-raised p-4">
          <dt class="label">Products live</dt>
          <dd class="mt-2 font-display text-2xl font-semibold text-bone">{productProjects.length}</dd>
        </div>
      </dl>
    </div>
    <div class="relative z-10 hidden justify-self-end md:block">
      <div class="frame border border-line bg-surface-raised p-2">
        <Image
          src={portrait}
          alt={`${site.name} speaking at KCD Spain`}
          class="h-[340px] w-[280px] object-cover grayscale contrast-110"
          width={560}
          height={680}
          fit="cover"
          loading="eager"
        />
        <p class="mt-2 px-1 font-mono text-[10px] uppercase tracking-[0.14em] text-ash">
          {site.location}
        </p>
      </div>
    </div>
  </div>
</section>
