---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Newsletter from '../../components/Newsletter.astro';
import { coverUrl, formatDate } from '../../lib/utils';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Writing" description="Field notes on Kubernetes, platform engineering, FinOps, and Cloud Native.">
  <section class="border-b border-line py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <p class="label mb-3">[ field notes ]</p>
      <h1 class="font-display text-4xl font-bold tracking-tight text-bone sm:text-5xl">Writing</h1>
      <p class="mt-3 max-w-2xl text-ash">
        Engineering notes from the cockpit — clusters, cost, databases, GPUs, and platform culture.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <ul class="divide-y divide-line border border-line">
        {posts.map((post, index) => {
          const cover = coverUrl(post.data.cover);
          return (
            <li class="reveal" style={`transition-delay: ${Math.min(index, 8) * 40}ms`}>
              <a href={`/blog/${post.id}`} class="grid gap-4 p-5 hover:bg-surface-raised md:grid-cols-[140px_1fr] md:items-center">
                {cover ? (
                  <img
                    src={cover}
                    alt=""
                    class="h-24 w-full border border-line object-cover md:h-20"
                    loading="lazy"
                  />
                ) : (
                  <div class="hidden h-20 border border-line bg-surface-light md:block"></div>
                )}
                <div>
                  <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-ash">
                    {formatDate(post.data.date)}
                    {post.data.categories?.[0] && <> · {post.data.categories[0]}</>}
                  </p>
                  <h2 class="mt-1 font-display text-xl font-semibold text-bone">{post.data.title}</h2>
                  <p class="mt-1 text-sm text-ash">{post.data.description}</p>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
  <Newsletter />
</Layout>
