---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Newsletter from '../../components/Newsletter.astro';
import PostList from '../../components/PostList.astro';
import { site } from '../../data/socials';
import { Image } from 'astro:assets';
import portrait from '../../assets/images/portrait.jpeg';
import { formatDate, readingMinutes } from '../../lib/utils';
import { coverImage } from '../../lib/covers';
import { relatedTo } from '../../lib/posts';

type Post = CollectionEntry<'posts'>;

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
      related: relatedTo(post, posts),
    },
  }));
}

type Props = { post: Post; newer?: Post; older?: Post; related: Post[] };

const { post, newer, older, related } = Astro.props;
const { Content } = await render(post);
const cover = coverImage(post.data.cover);
const minutes = readingMinutes(post.body ?? '');
const url = new URL(`/blog/${post.id}`, site.url).href;
const shareImage = `/og/${post.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url,
  mainEntityOfPage: url,
  image: new URL(shareImage, site.url).href,
  keywords: post.data.tags.join(', '),
  author: { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#person` },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={shareImage}
  article={{ publishedTime: post.data.date, tags: post.data.tags }}
  jsonLd={jsonLd}
>
  <article>
    <header class="border-b border-line py-14 md:py-20">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <p class="label mb-4">
          [ field note ] · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {minutes} min read
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight tracking-tight text-bone sm:text-5xl">
          {post.data.title}
        </h1>
        <p class="mt-4 text-lg text-ash">{post.data.description}</p>
        <p class="mt-6 flex items-center gap-3 text-sm text-bone-dim">
          <Image
            src={portrait}
            alt=""
            width={64}
            height={64}
            fit="cover"
            class="h-8 w-8 rounded-full border border-line object-cover grayscale"
          />
          <span>
            By <a href="/cv" class="text-bone hover:text-accent">{site.name}</a>, Staff Platform Engineer
          </span>
        </p>
        {post.data.tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="border border-line px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.1em] text-ash">
                {tag}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {cover && (
      <div class="mx-auto max-w-4xl px-4 pt-10 md:px-6">
        <Image
          src={cover}
          alt=""
          width={1728}
          widths={[640, 960, 1728]}
          sizes="(min-width: 896px) 848px, 100vw"
          loading="eager"
          class="h-auto w-full border border-line"
        />
      </div>
    )}

    <div class="prose-cockpit mx-auto max-w-3xl px-4 py-12 md:px-6">
      <Content />
    </div>
  </article>

  <Newsletter />

  {related.length > 0 && (
    <section class="border-b border-line py-14">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <p class="label mb-3">[ related ]</p>
        <h2 class="mb-6 font-display text-2xl font-bold text-bone">Keep reading</h2>
        <PostList posts={related} />
      </div>
    </section>
  )}

  <nav class="py-10" aria-label="Posts">
    <div class="mx-auto grid max-w-3xl gap-4 px-4 sm:grid-cols-2 md:px-6">
      {older ? (
        <a href={`/blog/${older.id}`} class="group border border-line p-4 hover:border-accent">
          <p class="label">◂ older</p>
          <p class="mt-1 font-display font-semibold text-bone group-hover:text-accent">{older.data.title}</p>
        </a>
      ) : (
        <span></span>
      )}
      {newer && (
        <a href={`/blog/${newer.id}`} class="group border border-line p-4 text-right hover:border-accent">
          <p class="label">newer ▸</p>
          <p class="mt-1 font-display font-semibold text-bone group-hover:text-accent">{newer.data.title}</p>
        </a>
      )}
    </div>
  </nav>
</Layout>

<style is:global>
  .prose-cockpit {
    color: var(--color-bone-dim);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-cockpit h2,
  .prose-cockpit h3,
  .prose-cockpit h4 {
    color: var(--color-bone);
    font-family: var(--font-display);
    font-weight: 700;
    margin-top: 2.2em;
    margin-bottom: 0.6em;
    letter-spacing: -0.02em;
  }
  .prose-cockpit h2 { font-size: 1.65rem; }
  .prose-cockpit h3 { font-size: 1.3rem; }
  .prose-cockpit p { margin: 1.1em 0; }
  .prose-cockpit a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-cockpit ul,
  .prose-cockpit ol {
    margin: 1em 0;
    padding-left: 1.4em;
  }
  .prose-cockpit li { margin: 0.35em 0; }
  .prose-cockpit blockquote {
    border-left: 2px solid var(--color-accent);
    margin: 1.5em 0;
    padding-left: 1em;
    color: var(--color-ash);
  }
  .prose-cockpit pre {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5em 0;
    font-size: 0.85rem;
  }
  .prose-cockpit code {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  .prose-cockpit :not(pre) > code {
    background: var(--color-surface-light);
    border: 1px solid var(--color-line);
    padding: 0.1em 0.35em;
    color: var(--color-accent);
  }
  .prose-cockpit img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    margin: 1.5em 0;
  }
  .prose-cockpit hr {
    border: none;
    border-top: 1px solid var(--color-line);
    margin: 2.5em 0;
  }
  .prose-cockpit table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.9rem;
  }
  .prose-cockpit th,
  .prose-cockpit td {
    border: 1px solid var(--color-line);
    padding: 0.5em 0.75em;
    text-align: left;
  }
</style>
