---
import Layout from '../layouts/Layout.astro';
import { talks } from '../data/talks';
---

<Layout title="Speaking" description="Conference talks and community sessions on Kubernetes, FinOps, and platform engineering.">
  <section class="border-b border-line py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <p class="label mb-3">[ session log ]</p>
      <h1 class="font-display text-4xl font-bold tracking-tight text-bone sm:text-5xl">Speaking</h1>
      <p class="mt-3 max-w-2xl text-ash">
        Transmissions from KCDs, DevFests, HashiTalks, and local communities — FinOps, Velero, Spark, and platform engineering.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <ol class="divide-y divide-line border border-line">
        {talks.map((talk, index) => (
          <li class="reveal" style={`transition-delay: ${Math.min(index, 10) * 40}ms`}>
            <a
              href={talk.url ?? '#'}
              target={talk.url ? '_blank' : undefined}
              rel={talk.url ? 'noopener noreferrer' : undefined}
              class="grid gap-2 px-5 py-6 hover:bg-surface-raised md:grid-cols-[100px_1fr_auto] md:items-baseline"
            >
              <span class="font-mono text-xs text-accent">{talk.session}</span>
              <div>
                <h2 class="font-display text-xl font-semibold text-bone">{talk.title}</h2>
                <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.12em] text-ash">
                  {talk.event} · {talk.date}
                </p>
              </div>
              {talk.url && (
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ash md:justify-self-end">
                  watch ↗
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
