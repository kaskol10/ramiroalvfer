---
import '@fontsource/syne/latin-600.css';
import '@fontsource/syne/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/images/portrait.jpeg';
import '../styles/global.css';
import { site, socials } from '../data/socials';

type Props = {
  title?: string;
  description?: string;
  /** Share image path; defaults to the generated site card. */
  image?: string;
  /** Set for blog posts: switches Open Graph to `article` and adds the publish date. */
  article?: { publishedTime: Date; tags?: string[] };
  /** Extra schema.org object for this page (the site-wide Person is always included). */
  jsonLd?: Record<string, unknown>;
};

const { title, description = site.description, image = '/og/default.png', article, jsonLd } = Astro.props;

const personImage = await getImage({ src: portrait, width: 600, format: 'jpeg' });

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: site.url,
  image: new URL(personImage.src, site.url).href,
  jobTitle: 'Staff Platform Engineer',
  description: site.description,
  sameAs: [socials.github, socials.linkedin, socials.x],
};
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.persona}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const navLinks = [
  { href: '/#projects', label: 'Projects' },
  { href: '/blog', label: 'Writing' },
  { href: '/speaking', label: 'Speaking' },
  { href: '/cv', label: 'CV' },
  { href: '/log', label: 'Log' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={`${site.name} · ${site.persona}`} />
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    {article && <meta property="article:author" content={site.name} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content={socials.xHandle} />
    <meta name="twitter:creator" content={socials.xHandle} />
    <link rel="icon" type="image/png" href="/images/logo-200.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent focus:px-3 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-40 border-b border-line/80 bg-surface/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
        <a href="/" class="group flex items-center gap-3">
          <span class="font-display text-lg font-bold tracking-tight text-bone group-hover:text-accent">
            {site.name}
          </span>
          <span class="hidden font-mono text-[10px] uppercase tracking-[0.16em] text-ash sm:inline">
            [ {site.persona} ]
          </span>
        </a>
        <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={['label hover:text-accent', isCurrent(link.href) && 'text-accent']}
            >
              {link.label}
            </a>
          ))}
          <a
            href={socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-line px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-bone hover:border-accent hover:text-accent"
          >
            GitHub ↗
          </a>
        </nav>
        <details id="mobile-menu" class="relative md:hidden">
          <summary class="cursor-pointer list-none border border-line px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-bone">
            [ menu ]
          </summary>
          <div class="absolute right-0 mt-2 w-48 border border-line bg-surface-raised p-3 shadow-lg">
            <div class="flex flex-col gap-3">
              {navLinks.map((link) => (
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class:list={['label hover:text-accent', isCurrent(link.href) && 'text-accent']}
                >
                  {link.label}
                </a>
              ))}
              <a href={socials.github} class="label hover:text-accent" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </div>
          </div>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="mt-24 border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 md:flex-row md:items-end md:justify-between md:px-6">
        <div>
          <p class="label mb-2">[ contact ]</p>
          <p class="font-display text-2xl font-semibold text-bone">{site.name}</p>
          <p class="mt-1 max-w-md text-sm text-ash">{site.title}</p>
          <p class="mt-1 font-mono text-xs text-ash">{site.location}</p>
        </div>
        <div class="flex flex-wrap gap-4 font-mono text-xs uppercase tracking-[0.12em]">
          <a href={`mailto:${site.email}`} class="text-bone-dim hover:text-accent">{site.email}</a>
          <a href={socials.canispot} class="text-bone-dim hover:text-accent" target="_blank" rel="noopener noreferrer">CanISpot.ai</a>
          <a href={socials.minirss} class="text-bone-dim hover:text-accent" target="_blank" rel="noopener noreferrer">MiniRSS.ai</a>
          <a href={socials.github} class="text-bone-dim hover:text-accent" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={socials.linkedin} class="text-bone-dim hover:text-accent" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={socials.x} class="text-bone-dim hover:text-accent" target="_blank" rel="me noopener noreferrer">X</a>
          <a href="/rss.xml" class="text-bone-dim hover:text-accent">RSS</a>
        </div>
      </div>
      <div class="border-t border-line/60 py-4 text-center font-mono text-[10px] uppercase tracking-[0.14em] text-ash">
        © {new Date().getFullYear()} · {site.persona} · Powered by Astro
      </div>
    </footer>
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) entry.target.classList.add('is-visible');
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Close the mobile menu on outside click, Escape, or after following a link.
      const menu = document.getElementById('mobile-menu');
      if (menu instanceof HTMLDetailsElement) {
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Node)) return;
          if (!menu.contains(target) || (target instanceof Element && target.closest('a'))) menu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') menu.open = false;
        });
      }
    </script>
  </body>
</html>
